# =====================================================================
# BRANSION — Environment variables (EXAMPLE / TEMPLATE)
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — this file is safe to commit.
# =====================================================================

# ---------- SUPABASE ----------
# From https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ⚠️ SERVER-ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- PAYSTACK ----------
# From https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Test mode keys start with sk_test_ / pk_test_. Live keys with sk_live_ / pk_live_.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ---------- APP ----------
# The full URL of your deployed app. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The Google email that gets promoted to admin automatically on first sign-in.
ADMIN_EMAIL=youradmin@gmail.com
# Random 16+ char secret used to authorize the monthly maintenance cron.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-at-least-16-chars-long
# WhatsApp number for "I don't have a design, create one for me" links.
# Format: country code + number, digits only. e.g. 2348000000000
NEXT_PUBLIC_WHATSAPP_SUPPORT=2348000000000